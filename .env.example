# LLM provider (MiMo is the default)
LLM_PROVIDER=mimo
MIMO_MODEL=mimo-v2.5-pro
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TAVILY_API_KEY=
EMBEDDING_PROVIDER=local_hash
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
DATABASE_URL=sqlite:///data/goldagent.db
DEMO_MODE=true
JWT_SECRET_KEY=change-me-in-production
FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8000
REDIS_URL=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
